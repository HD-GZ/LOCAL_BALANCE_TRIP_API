SPRING_OUTPUT_ANSI_ENABLED=always
DB_URL=jdbc:mysql://localhost:3306/local_balance_trip?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_password
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=change-this-secret-to-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d
JWT_ADMIN_SECRET=change-this-secret-to-at-least-32-bytes
JWT_ADMIN_ACCESS_TOKEN_EXPIRATION=30m
MAIL_FROM=no-reply@localbalancetrip.kr
EMAIL_VERIFICATION_CODE_EXPIRATION=24h
SWAGGER_SERVER_URL=http://localhost:8080
SENDGRID_API_KEY=your_sendgrid_api_key
OPENAI_API_KEY=your_openai_api_key
MAX_IMAGE_SIZE=10MB
MAX_REQUEST_SIZE=11MB
S3_BUCKET=your_s3_bucket
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
CDN_BASE_URL=https://images.example.com
TOUR_API_SERVICE_KEY=your_tour_api_service_key
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=lbtrip
TOUR_API_READ_TIMEOUT=5s
SLACK_LOGGING_ERROR_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
